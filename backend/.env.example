# Chave oficial da API Gemini (NUNCA exponha no frontend)
GEMINI_API_KEY=

# Modelo Gemini utilizado pelo backend
GEMINI_MODEL=gemini-2.5-flash

# Porta do servidor HTTP
PORT=3000

# Origens CORS permitidas (separadas por vírgula ou * para permitir app Android e WebView)
CORS_ORIGIN=*

# Configuração do rate limit (janela em ms e máximo de requisições por IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=15
